FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application simpleFoam;

startFrom startTime;
startTime 0;
stopAt endTime;
endTime 2000;
deltaT 1;

writeControl timeStep;
writeInterval 2000;
purgeWrite 0;
writeFormat ascii;
writeFormatOptions { precision 15; }
timeFormat general;
timePrecision 8;

functions
{
    pInlet
    {
        type surfaceFieldValue;
        libs ("libfieldFunctionObjects.so");
        writeControl timeStep;
        writeInterval 50;
        regionType patch;
        name inlet;
        operation areaAverage;
        fields (p);
    }
    pOutlet
    {
        type surfaceFieldValue;
        libs ("libfieldFunctionObjects.so");
        writeControl timeStep;
        writeInterval 50;
        regionType patch;
        name outlet;
        operation areaAverage;
        fields (p);
    }
    qInlet
    {
        type surfaceFieldValue;
        libs ("libfieldFunctionObjects.so");
        writeControl timeStep;
        writeInterval 50;
        regionType patch;
        name inlet;
        operation sum;
        fields (phi);
    }
    qOutlet
    {
        type surfaceFieldValue;
        libs ("libfieldFunctionObjects.so");
        writeControl timeStep;
        writeInterval 50;
        regionType patch;
        name outlet;
        operation sum;
        fields (phi);
    }
}
