{
  "schema_version": "0.1",
  "project": "valve_design_from_ga",
  "created": "2026-10-06",
  "status": "TEMPLATE_NOT_EXECUTION_READY",
  "scope": "design_only",
  "requires_real_inputs": true,
  "notes": [
    "任务图为每个候选设计的一轮模板；迭代创建新 DAG，不在当前 DAG 中回连。",
    "SUCCEEDED 代表作业产物有效，不代表工程指标通过。",
    "T33/T34 仅在确认不适用后写入显式豁免结果；null 是待定，不是 false。",
    "本附件不是已部署的调度器或已经验证的阀门设计。"
  ],
  "project_flags": {
    "system_scope": null,
    "coupling_scope": null
  },
  "roles": {
    "O": "总体设计／集成",
    "R": "需求与标准",
    "M": "机械与结构",
    "C": "CAD",
    "F": "流体与系统",
    "V": "独立核验",
    "D": "文档执行器"
  },
  "resource_pools": {
    "light": {
      "max_concurrent": 4
    },
    "cad": {
      "max_concurrent": 1,
      "exclusive_session": true
    },
    "cae": {
      "max_concurrent": 1,
      "note": "CFD 与 FEA 共享；按实测 CPU/RAM/许可调整"
    },
    "capability_probe": {
      "max_concurrent": 1
    }
  },
  "task_completion": {
    "run_status": [
      "PENDING",
      "READY",
      "RUNNING",
      "SUCCEEDED",
      "FAILED",
      "BLOCKED",
      "CANCELLED"
    ],
    "numerical_status": [
      "NOT_APPLICABLE",
      "NOT_ASSESSED",
      "VALID",
      "INVALID"
    ],
    "requirement_status": [
      "NOT_ASSESSED",
      "PASS",
      "FAIL",
      "UNKNOWN",
      "WAIVED_WITH_REASON"
    ]
  },
  "tasks": [
    {
      "id": "T01",
      "name": "资料入库与版本登记",
      "owner": "R",
      "depends_on": [],
      "action": "登记外形图、技术说明及已知历史资料；保存原件，识别文件格式、单位与可解析程度。",
      "output": "input_manifest.json；原件哈希；缺件清单。",
      "acceptance_check": "原件只读；不得声称已读取缺失图纸。",
      "resource_pool": "light",
      "when": "always",
      "fanout": null,
      "write_scope": "runs/{run_id}/{candidate_id}/T01/",
      "max_attempts": 2,
      "start_guards": []
    },
    {
      "id": "T02",
      "name": "外形图参数提取",
      "owner": "R",
      "depends_on": [
        "T01"
      ],
      "action": "提取标注尺寸、接口、包络及图纸说明；区分明确标注、比例估算和未知。",
      "output": "ga_facts.json；每项对应图号、视图或位置。",
      "acceptance_check": "单位一致；关键参数有证据；估算不自动冻结。",
      "resource_pool": "light",
      "when": "always",
      "fanout": null,
      "write_scope": "runs/{run_id}/{candidate_id}/T02/",
      "max_attempts": 2,
      "start_guards": []
    },
    {
      "id": "T03",
      "name": "标准适用性与条款映射",
      "owner": "R",
      "depends_on": [
        "T01"
      ],
      "action": "依已知用途筛选产品、压力设计、连接与性能标准；建立版本、范围和正文可用性台账。",
      "output": "standards_matrix.json；条款规则候选；冲突单。",
      "acceptance_check": "无正文不得生成条款级通过结论；适用性未定保留待定。",
      "resource_pool": "light",
      "when": "always",
      "fanout": null,
      "write_scope": "runs/{run_id}/{candidate_id}/T03/",
      "max_attempts": 2,
      "start_guards": []
    },
    {
      "id": "T04",
      "name": "工具链与资源冒烟测试",
      "owner": "C",
      "depends_on": [
        "T01"
      ],
      "action": "用独立测试模型验证打开、重建、导出、简单网格和求解结果读取；检测版本、许可与资源。",
      "output": "capability_matrix.json；测试日志；资源画像。",
      "acceptance_check": "每个适配器独立标记已验证／不可用；不能因 CAD 可用推定 CFD 可用。",
      "resource_pool": "capability_probe",
      "when": "always",
      "fanout": null,
      "write_scope": "runs/{run_id}/{candidate_id}/T04/",
      "max_attempts": 2,
      "start_guards": []
    },
    {
      "id": "T05",
      "name": "材料与物性证据登记",
      "owner": "R",
      "depends_on": [
        "T01"
      ],
      "action": "登记候选材料、许用值与温度范围；收集密度、黏度、蒸气压及摩擦系数来源和不确定性。",
      "output": "property_registry.json；来源、有效范围、缺口。",
      "acceptance_check": "不给无来源数值；材料选择与使用范围在 T07 确认。",
      "resource_pool": "light",
      "when": "always",
      "fanout": null,
      "write_scope": "runs/{run_id}/{candidate_id}/T05/",
      "max_attempts": 2,
      "start_guards": []
