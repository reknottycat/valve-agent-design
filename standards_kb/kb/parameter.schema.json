{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standards_kb.parameter/1.0",
  "title": "标准参数条目 (Standard Parameter Entry)",
  "description": "一条参数 = 一个可复用的标量 + 单位 + 适用条件 + 出处 + 在哪用 + 证据等级。参数是标准里'不需要再推导、只需要查'的东西：常数、系数、限值、阈值、缺省替代值、单位换算因子。尺寸表/公差表/压力等级表属于数据表层(kb/data)，不在这里。",
  "type": "object",
  "required": [
    "id",
    "title_zh",
    "param_kind",
    "value",
    "unit",
    "domain",
    "source",
    "applicability",
    "usage",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^P-[A-Z]{2,4}-[0-9]{3}$",
      "description": "参数唯一 ID。域前缀 + 序号,例: P-TEST-001 试验常数 / P-MAT-004 材料阈值"
    },

    "title_zh": {
      "type": "string",
      "minLength": 2,
      "description": "中文名称,人能读懂"
    },

    "title_en": {
      "type": "string",
      "description": "英文名(标准原文用词)"
    },

    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "别名与常见叫法,供检索命中。例:['0.878','排放系数上限','K 上限']"
    },

    "param_kind": {
      "type": "string",
      "enum": [
        "CONSTANT",
        "COEFFICIENT",
        "LIMIT",
        "THRESHOLD",
        "RANGE",
        "DEFAULT_SUBSTITUTE",
        "UNIT_FACTOR",
        "MATERIAL_PROPERTY"
      ],
      "description": "参数种类。CONSTANT 公式里的常数 / COEFFICIENT 无量纲系数 / LIMIT 上下限或上限 / THRESHOLD 判据阈值 / RANGE 适用区间 / DEFAULT_SUBSTITUTE 缺省替代值 / UNIT_FACTOR 单位换算因子 / MATERIAL_PROPERTY 材料性能值"
    },

    "symbol": {
      "type": ["string", "null"],
      "description": "标准原文里代表该参数的记号。原文没有独立记号时填 null(不要留空字符串占位)。例:'K' / 'CE'"
    },

    "value": {
      "type": "object",
      "required": ["canonical"],
      "description": "参数值。canonical 是唯一权威形式(ASCII),display 是可读形式,两者必须能对上。",
      "properties": {
        "canonical": {
          "type": "string",
          "minLength": 1,
          "description": "规范化取值,ASCII 记号。例:'2407' / '<= 0.45' / '0.15..0.75' / '1/500'"
        },
        "display": {
          "type": "string",
          "description": "可读形式,保留原文排印。例:'2,407' / '≤ 0.45'"
        },
        "latex": {
          "type": "string",
          "description": "LaTeX 形式,用于排版"
        },
        "numeric": {
          "type": ["number", "null"],
          "description": "数值形式(仅当参数是单个数时给)。RANGE 给基准值并在 min/max 另给边界;带关系符的给阈值本体。无法归约为单个数时填 null。"
        },
        "min": {
          "type": ["number", "null"],
          "description": "区间下界。RANGE 类必填,其余填 null"
        },
        "max": {
          "type": ["number", "null"],
          "description": "区间上界。RANGE 类必填,其余填 null"
        },
        "relation": {
          "type": "string",
          "enum": ["=", "<", "<=", ">", ">=", "±", "range", "approx"],
          "description": "数值与判据的关系。阈值类必须给,不要只写数字。"
        },
        "unit_text": {
          "type": "string",
          "description": "标准原文写的单位串(逐字)。例:'lb/hr (kg/hr)' / 'psia (MPa)'"
        },
        "alt_values": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["canonical"],
            "properties": {
              "canonical": { "type": "string", "minLength": 1 },
              "display": { "type": "string" },
              "unit_text": { "type": "string" },
              "note": { "type": "string" }
            }
          },
          "description": "同一参数的其它单位制取值。例:'2,407' 与 '5,092' 分别是同一常数在 US/SI 下的值"
        }
      }
    },

    "unit": {
      "type": "string",
      "minLength": 1,
      "description": "本参数值的单位或 'dimensionless'。无量纲系数写 dimensionless,便于按单位筛。"
    },

    "domain": {
      "type": "string",
      "enum": [
        "FLOW", "STRUCT", "SEAL", "BOLT", "MATE", "TEST", "GEOM",
        "THERM", "MASS", "DRIVE", "TOL", "PIPE"
      ],
      "description": "设计域,与公式条目同一套取值,便于两层互相检索"
    },

    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "自由标签,例:['安全阀','试验','排放系数']"
    },

    "source": {
      "type": "object",
      "description": "出处。必须能回溯到正文位置,不能只写标准号。",
      "required": ["standard_id", "clause", "body_status"],
      "properties": {
        "standard_id": {
          "type": "string",
          "minLength": 1,
          "description": "标准号+版本,例:'ASME BPVC Section I-2010' / 'ASME B31.1-2007'"
        },
        "clause": {
          "type": "string",
          "description": "条款号/章节号/表号。例:'PG-69.2.3' / 'Table PW-39 通用注 (a)(2)(a)'"
        },
        "body_status": {
          "type": "string",
          "enum": [
            "FULL_TEXT_MIRROR",
            "OFFICIAL_LIST",
            "PAYWALL",
            "RENDERED_JS",
            "LOCAL_FILE",
            "DERIVED_NO_TEXT"
          ],
          "description": "正文获取状态。与 registry/sources.yaml 同义。"
        },
        "evidence_grade": {
          "type": "string",
          "enum": ["E0", "E1", "E2", "E3"],
          "description": "见 evidence.grade"
        },
        "snippet": {
          "type": "string",
          "description": "原文摘录(短)。必须逐字,不得改写。"
        },
        "locator": {
          "type": "string",
          "description": "本地定位:文件路径+页/行。例:'runs/ASME-BPVC-I/bpvc_i_djvu.txt L22685'"
        },
        "visual_verified": {
          "type": "boolean",
          "description": "是否已在 PDF 渲染页图上肉眼核过该数值。true 才允许 VERIFIED_CLAUSE(文本层已多次实测丢小数点/丢分数形)"
        },
        "extraction_note": {
          "type": "string",
          "description": "抽取过程说明与已知缺陷。"
        },
        "cross_refs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "其他相关条目 ID(可跨层指向公式 F-xxx 或参数 P-xxx)"
        }
      }
    },

    "applicability": {
      "type": "object",
      "description": "什么时候能用、什么时候不能用。",
      "required": ["valid_when", "not_valid_when"],
      "properties": {
        "valid_when": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "成立条件"
        },
        "not_valid_when": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "失效条件"
        },
        "range_limits": {
          "type": "array",
          "items": { "type": "string" },
          "description": "量级/范围限制"
        },
        "conservatism": {
          "type": "string",
          "description": "偏安全还是偏危险"
        },
        "must_pair_with": {
          "type": "array",
          "items": { "type": "string" },
          "description": "必须同时满足的其他要求/条目 ID"
        }
      }
    },

    "usage": {
      "type": "object",
      "description": "在哪用、怎么用。",
      "required": ["where", "how"],
      "properties": {
        "where": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "使用场景"
        },
        "how": {
          "type": "string",
          "minLength": 1,
          "description": "怎么用:代入什么、单位怎么处理、判据是什么"
        },
        "step_order": {
          "type": "array",
          "items": { "type": "string" },
          "description": "在使用链中的位置"
        },
        "output_used_by": {
          "type": "array",
          "items": { "type": "string" },
          "description": "本参数被哪些公式/任务消费"
        },
        "pitfalls": {
          "type": "array",
          "items": { "type": "string" },
          "description": "常见误用"
        }
      }
    },

    "evidence": {
      "type": "object",
      "required": ["grade", "status"],
      "description": "证据等级与状态。沿用本项目 E0-E3 体系。",
      "properties": {
        "grade": {
          "type": "string",
          "enum": ["E0", "E1", "E2", "E3"],
          "description": "E0 工具能跑;E1 数值与公式自洽;E2 可比物理数据验证;E3 本产品实测"
        },
        "status": {
          "type": "string",
          "enum": [
            "VERIFIED_CLAUSE",
            "UNVERIFIED_CLAUSE",
            "PENDING_VERIFICATION",
            "CONFLICT",
            "SUPERSEDED"
          ],
          "description": "没拿到正文就只能是 UNVERIFIED_CLAUSE;数值未在页图上核过只能是 PENDING_VERIFICATION。"
        },
        "verified_on": { "type": "string", "description": "YYYY-MM-DD" },
        "verified_by": { "type": "string" },
        "note": { "type": "string" }
      }
    },

    "project_usage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task", "status"],
        "properties": {
          "task": { "type": "string", "description": "项目内任务号,例:'T15'" },
          "status": { "type": "string" },
          "note": { "type": "string" }
        }
      },
      "description": "在本项目(522-35.4179СБ)里的落地情况"
    },

    "related": {
      "type": "array",
      "items": { "type": "string" },
      "description": "相关条目 ID(可跨层)。构成知识图谱的边。"
    }
  }
}
