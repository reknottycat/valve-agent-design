{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standards_kb.formula/1.0",
  "title": "标准公式条目 (Standard Formula Entry)",
  "description": "一条公式 = 表达式 + 变量定义 + 适用条件 + 出处 + 在哪用 + 证据等级。这是从标准正文中'反编译'出来的最小单元。",
  "type": "object",
  "required": [
    "id",
    "title_zh",
    "expression",
    "variables",
    "domain",
    "source",
    "applicability",
    "usage",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^F-[A-Z]{2,4}-[0-9]{3}$",
      "description": "公式唯一 ID。域前缀 + 序号,例: F-STR-001 强度 / F-FLW-002 流动 / F-SEAL-003 密封"
    },

    "title_zh": {
      "type": "string",
      "minLength": 2,
      "description": "中文名称,人能读懂"
    },

    "title_en": {
      "type": "string",
      "description": "英文名(标准原文用词)"
    },

    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "别名与常见叫法,供检索命中。例:['薄膜公式','薄壁圆筒公式','Hoop Stress']"
    },

    "expression": {
      "type": "object",
      "required": ["canonical"],
      "properties": {
        "canonical": {
          "type": "string",
          "minLength": 1,
          "description": "规范化表达式,ASCII 记号。例: sigma_h = p * D / (2 * t_net)"
        },
        "display": {
          "type": "string",
          "description": "带上下标与单位的可读形式,例: σ_h = p·D/(2·t_net)"
        },
        "latex": {
          "type": "string",
          "description": "LaTeX 形式,用于排版"
        },
        "rearranged_forms": {
          "type": "array",
          "items": { "type": "string" },
          "description": "等价变形形式(求 t_min 求 A 求 σ 各一式),便于按问题找公式"
        },
        "solved_for": {
          "type": "string",
          "description": "本式解出的目标量,例:'t_min'。用于'我要算壁厚'这类反向检索"
        }
      }
    },

    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["symbol", "name_zh", "unit"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1, "description": "记号,例:'t_net'" },
          "name_zh": { "type": "string", "minLength": 1 },
          "name_en": { "type": "string" },
          "unit": { "type": "string", "minLength": 1, "description": "单位或 'dimensionless'" },
          "typical_range": {
            "type": "string",
            "description": "常见取值范围,便于判断公式适用性"
          },
          "source_of_value": {
            "type": "string",
            "description": "这个量通常从哪来。例:'DRAWING 图纸标注' / 'STANDARD 标准表' / 'DERIVED 由上游公式导出'"
          },
          "note": { "type": "string" }
        }
      }
    },

    "domain": {
      "type": "string",
      "enum": [
        "FLOW", "STRUCT", "SEAL", "BOLT", "MATE", "TEST", "GEOM",
        "THERM", "MASS", "DRIVE", "TOL", "PIPE"
      ],
      "description": "设计域。用于按主题检索与生成索引"
    },

    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "自由标签,例:['薄膜','厚壁','Lame']"
    },

    "source": {
      "type": "object",
      "description": "出处。必须能回溯到正文位置,不能只写标准号。",
      "required": ["standard_id", "clause", "body_status"],
      "properties": {
        "standard_id": {
          "type": "string",
          "minLength": 1,
          "description": "标准号+版本,例:'ASME B31.9-2008' / 'GB/T 1226-2015' / 'ГОСТ 1536-76'"
        },
        "clause": {
          "type": "string",
          "description": "条款号/章节号,例:'para. 902.3.1' / '表 4 第 3 列'"
        },
        "body_status": {
          "type": "string",
          "enum": [
            "FULL_TEXT_MIRROR",
            "OFFICIAL_LIST",
            "PAYWALL",
            "RENDERED_JS",
            "LOCAL_FILE",
            "DERIVED_NO_TEXT"
          ],
          "description": "正文获取状态。与 registry/sources.yaml 同义。"
        },
        "evidence_grade": {
          "type": "string",
          "enum": ["E0", "E1", "E2", "E3"],
          "description": "见 evidence.grade"
        },
        "snippet": {
          "type": "string",
          "description": "原文摘录(短)。必须逐字,不得改写。"
        },
        "locator": {
          "type": "string",
          "description": "本地定位:文件路径+页/行,例:'runs/probe/b31_9_djvu.txt:L4120'"
        },
        "extraction_note": {
          "type": "string",
          "description": "抽取过程说明与已知缺陷。OCR 来的必须写明符号退化情况。"
        },
        "cross_refs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "其他相关公式 ID"
        }
      }
    },

    "applicability": {
      "type": "object",
      "description": "什么时候能用、什么时候不能用。这是公式最容易被误用的地方。",
      "required": ["valid_when", "not_valid_when"],
      "properties": {
        "valid_when": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "成立条件,例:['壁厚 t/D < 0.1','内压为唯一载荷','无温度梯度']"
        },
        "not_valid_when": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "失效条件。例:['厚壁或加强结构','有外部压力','温差应力主导']"
        },
        "range_limits": {
          "type": "array",
          "items": { "type": "string" },
          "description": "量级/范围限制,例:['雷诺数 < 2000 不可用', '仅不可压缩液体']"
        },
        "conservatism": {
          "type": "string",
          "description": "偏安全还是偏危险。例:'偏危险,仅可作量级校核'"
        },
        "must_pair_with": {
          "type": "array",
          "items": { "type": "string" },
          "description": "必须同时满足的其他要求/公式 ID"
        }
      }
    },

    "usage": {
      "type": "object",
      "description": "在哪用、怎么用。用户明确问过这三件事。",
      "required": ["where", "how"],
      "properties": {
        "where": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "使用场景。例:['T15 承压壁厚校核','CFD 网格边界设定','选型阶段快速估算']"
        },
        "how": {
          "type": "string",
          "minLength": 1,
          "description": "怎么用:代入顺序、单位处理、判据是什么"
        },
        "step_order": {
          "type": "array",
          "items": { "type": "string" },
          "description": "在使用链中的位置,例:['1. 由公称通径得 A','2. 由 A 得 F','3. 由 F 得 σ']"
        },
        "output_used_by": {
          "type": "array",
          "items": { "type": "string" },
          "description": "本式的输出被哪些公式/任务消费"
        },
        "sample": {
          "type": "object",
          "description": "算例。用本项目真实数据,便于复算与验收。",
          "properties": {
            "inputs": { "type": "object" },
            "result": { "type": "string" },
            "source_of_inputs": {
              "type": "string",
              "description": "输入取自图纸/假设/标准表"
            }
          }
        },
        "pitfalls": {
          "type": "array",
          "items": { "type": "string" },
          "description": "常见误用。例:['把公称压力当设计压力','把薄膜公式用在铸件阀体上']"
        }
      }
    },

    "evidence": {
      "type": "object",
      "required": ["grade", "status"],
      "description": "证据等级与状态。沿用本项目 E0-E3 体系。",
      "properties": {
        "grade": {
          "type": "string",
          "enum": ["E0", "E1", "E2", "E3"],
          "description": "E0 工具能跑;E1 公式自洽;E2 可比物理数据验证;E3 本产品实测"
        },
        "status": {
          "type": "string",
          "enum": [
            "VERIFIED_CLAUSE",
            "UNVERIFIED_CLAUSE",
            "PENDING_VERIFICATION",
            "CONFLICT",
            "SUPERSEDED"
          ],
          "description": "没拿到正文就只能是 UNVERIFIED_CLAUSE。"
        },
        "verified_on": { "type": "string", "description": "YYYY-MM-DD" },
        "verified_by": { "type": "string" },
        "note": { "type": "string" }
      }
    },

    "project_usage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task", "status"],
        "properties": {
          "task": { "type": "string", "description": "项目内任务号,例:'T15'" },
          "status": { "type": "string" },
          "note": { "type": "string" }
        }
      },
      "description": "在本项目(522-35.4179СБ)里的落地情况"
    },

    "related": {
      "type": "array",
      "items": { "type": "string" },
      "description": "相关公式 ID。构成知识图谱的边。"
    }
  }
}
