  "tables": [
    {
      "index": 1,
      "id": "D-GBT15530-PT-PN",
      "clause": "表 1",
      "chart_ref": "表 1 PN6~PN40 法兰压力-温度等级",
      "title_zh": "PN 系列法兰压力-温度等级(PN6~PN40)",
      "column_set": "pn_rating",
      "key_column": 1,
      "table_kind": "STRESS_TABLE",
      "design_domain": "THERM",
      "extraction_note": "人工逐格视觉转录: runs/GB-GB_T_15530.1-2008/pages/p0002.png(官方在线阅读页图像,2320x3280)。PN 列为行定位键(第 1 列,0 基)。注 a 保留在 usage.pitfalls。",
      "usage": {
        "where": [
          "校核设计工作温度下铜合金法兰的最大允许工作压力是否覆盖设计压力",
          "确定 PN 压力档位(PN6/10/16/25/40)与密封面型式(RF/TG/FF)的组合可行性",
          "铜合金件与钢件法兰混装时的压力校核"
        ],
        "how": "先按介质最高工作温度选列(120/200/250 ℃),再按 PN 选行,读出最大工作压力,与设计压力比较。本项目设计压力 0.588 MPa、工作温度不超 120 ℃: PN6 突面型最大工作压力 0.6 MPa ≥ 0.588 MPa,满足。",
        "pitfalls": [
          "本表只给 120/200/250 三个温度点,中间温度无直接数据,需按 GB/T 15530.8 技术条件内插或取最不利(邻近更低温度档)值",
          "注 a: 公称尺寸 DN250 以上的 PN6、PN10、PN16、PN25、PN40 的 TG 型、FF 型法兰最高使用温度不高于 120 ℃",
          "标的是「最大工作压力」,不等于「设计压力」,也不等于 ASME 的 design pressure 概念,两者不可直接换算",
          "铜合金法兰的许用压力远低于同 PN 的钢法兰,不可套用钢件的 PN 习惯值",
          "表内 DN 范围是「该 PN 与该密封面型式下的公称尺寸适用区间」,超出区间无表可查"
        ]
      },
      "project_usage": [
        {
          "task": "522-35.4179СБ DN200/PN6 青铜法兰压力校核",
          "status": "APPLICABLE",
          "note": "PN6 突面型 @120 ℃ 最大工作压力 0.6 MPa ≥ 设计压力 0.588 MPa,余量约 2%。余量很小,需在设计输入确认工作温度上限(见 B2 阻塞项:设计/试验压力未给)。"
        }
      ],
      "related": [
        "D-GBT15530-PN6-RF",
        "D-GBT15530-PT-CLASS"
      ],
      "source_page": "p0002.png"
    },
