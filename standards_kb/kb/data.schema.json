{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standards_kb.data/1.0",
  "title": "标准数据表条目 (Standard Data Table Entry)",
  "description": "标准正文里的表格类数据 —— 尺寸表、材料表、许用应力表、公差表、修正系数表。与公式条目同源同纪律：必须能回溯到正文位置，必须标证据等级。阀门设计真正卡住的地方，往往是这类表而不是公式。",
  "type": "object",
  "required": [
    "id",
    "title_zh",
    "table_kind",
    "standard_id",
    "clause",
    "columns",
    "rows",
    "body_status",
    "evidence",
    "usage"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^D-[A-Z0-9]{2,12}-[A-Z0-9-]{2,40}$",
      "description": "数据条目 ID。例: D-GOST1536-DN200-PN16 / D-BPVC-SA516-70-TEMPTABLE"
    },

    "title_zh": {
      "type": "string",
      "minLength": 2,
      "description": "中文名称"
    },

    "title_orig": {
      "type": "string",
      "description": "标准原文名称(俄/英),用于回溯核对"
    },

    "table_kind": {
      "type": "string",
      "enum": [
        "DIMENSION_TABLE",
        "MATERIAL_TABLE",
        "STRESS_TABLE",
        "TOLERANCE_TABLE",
        "CORRECTION_TABLE",
        "TEST_TABLE",
        "SEALING_TABLE",
        "THREAD_TABLE"
      ],
      "description": "表的性质。决定它能喂给哪类计算"
    },

    "design_domain": {
      "type": "string",
      "enum": ["FLOW", "STRUCT", "SEAL", "BOLT", "MATE", "TEST", "GEOM",
               "THERM", "MASS", "DRIVE", "TOL", "PIPE"],
      "description": "服务的设计域,用于按主题检索"
    },

    "standard_id": {
      "type": "string",
      "minLength": 1,
      "description": "标准号+版本,例:'ГОСТ 1536-76' / 'ASME BPVC Section I-2010'"
    },

    "clause": {
      "type": "string",
      "description": "条款/章节/表号,例:'Таблица 1' / 'UW-300' / 'Table UG-27'"
    },

    "table_ref": {
      "type": "string",
      "description": "原文表号,例:'Таблица 1 (размеры фланцев)'"
    },

    "body_status": {
      "type": "string",
      "enum": ["FULL_TEXT_MIRROR", "OFFICIAL_LIST", "PAYWALL",
               "RENDERED_JS", "LOCAL_FILE", "DERIVED_NO_TEXT"]
    },

    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "name_zh", "unit"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "description": "机器可读列名,例:'Dn'" },
          "name_zh": { "type": "string", "minLength": 1 },
          "name_orig": { "type": "string", "description": "原文列名(俄文/英文/符号)" },
          "unit": { "type": "string", "minLength": 1, "description": "单位或 'dimensionless'" },
          "note": { "type": "string" }
        }
      }
    },

    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "items": { "type": ["string", "number", "null"] },
        "description": "二维表。列数须与 columns 一致。"
      }
    },

    "row_keys": {
      "type": "object",
      "description": "每行的定位键,便于按参数取值。例:{'Dn200':{'Dn':'200','D':'320'}}。每个行键的值是一个对象,属性名只能是 columns 定义的列键或'行标注键'(annotation key),取值约定见根级 x-row-key-annotations。",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": ["string", "number", "null"] }
      }
    },
    "source": {
      "type": "object",
      "required": ["locator"],
      "properties": {
        "snippet": { "type": "string", "description": "原文摘录(逐字)" },
        "locator": { "type": "string", "description": "本地定位,例:'runs/GOST-LOCAL/gost_1536_76.txt:L412'" },
        "extraction_note": { "type": "string", "description": "抽取方式与已知缺陷" },
        "extraction_method": {
          "type": "string",
          "enum": ["HTML_TABLE", "PDF_TEXT", "PDF_LAYOUT", "OCR_TEXT", "MANUAL", "DERIVED"],
          "description": "数据从哪一层抽出来的"
        },
        "cross_refs": { "type": "array", "items": { "type": "string" } }
      }
    },

    "evidence": {
      "type": "object",
      "required": ["grade", "status"],
      "properties": {
        "grade": { "type": "string", "enum": ["E0", "E1", "E2", "E3"] },
        "status": {
          "type": "string",
          "enum": ["VERIFIED_CLAUSE", "UNVERIFIED_CLAUSE", "PENDING_VERIFICATION",
                   "CONFLICT", "SUPERSEDED"]
        },
        "verified_on": { "type": "string" },
        "verified_by": { "type": "string" },
        "note": { "type": "string" }
      }
    },

    "usage": {
      "type": "object",
      "required": ["where", "how"],
      "properties": {
        "where": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "how": { "type": "string", "minLength": 1 },
        "pitfalls": { "type": "array", "items": { "type": "string" } }
      }
    },

    "project_usage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task", "status"],
        "properties": {
          "task": { "type": "string" },
          "status": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },

    "related": {
      "type": "array",
      "items": { "type": "string" },
      "description": "相关公式 ID 或数据条目 ID"
    }
  },

  "x-row-key-alignment": {
    "description": "row_keys 与 rows 的对齐契约。两者是**并行结构**:row_keys 是有序字典,第 i 个项对应 rows[i]。校验器必须验证该对齐,否则行序错位会让每次按键取值都拿到错行数据,且不会有任何报错。",
    "rules": [
      "len(row_keys) == len(rows)",
      "row_keys[i] 中每个列键的取值必须等于 rows[i] 中同名列的取值(容许 str/int 表示差异,None 只与 None 等价)",
      "row_keys 的键必须能在同一行的某一列取值中找到(键由某列值字符串化而来)",
      "带 ref_table 标注的引用行:除定位键列外,其余数值列必须为 null —— 跨表引用不填 0、不抄别表数值"
    ]
  },

  "x-row-key-annotations": {
    "description": "行标注键(annotation key)约定。row_keys 里除 columns 定义的列键以外,还允许承载'该行的限定条件'而非数值的键 —— 最典型的是跨表引用:该行数值取自另一张表,本行数值列留 null,引用关系记在行标注里。约定写在 schema 而不是校验器里,校验器按本契约放行。",
    "prefixes": ["ref_"],
    "suffixes": ["_note"],
    "value_types": ["string"],
    "semantics": {
      "ref_table": "本行数值取自哪张表(跨表引用)。本行对应数值列留 null,不填 0、不抄别的表。",
      "ref_note": "原文对该行的引用说明(逐字或贴近逐字)。",
      "ref_standard_clause": "被引用内容所在的标准条款,便于回溯核对。",
      "dn_note": "该行公称直径/尺寸档的附加限定,例:'(225)a —— 带括号尺寸不推荐使用'。"
    },
    "rules": [
      "标注键必须匹配 prefixes 或 suffixes 之一",
      "标注键的取值必须是 string(本版契约)",
      "标注键不得与 columns 的列键同名"
    ]
  }
}
